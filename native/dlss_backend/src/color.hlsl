Texture2D<float4> source : register(t0);
RWTexture2D<float4> output : register(u0);
cbuffer Settings : register(b0) {float contrast,gamma,vibrance,brightness,saturation,hue,intensity,tone,structure,rx,ry,rw,rh;uint width,height;};
float3 linearize(float3 v){return float3(v.r<=.04045?v.r/12.92:pow((v.r+.055)/1.055,2.4),v.g<=.04045?v.g/12.92:pow((v.g+.055)/1.055,2.4),v.b<=.04045?v.b/12.92:pow((v.b+.055)/1.055,2.4));}
float3 encode(float3 v){v=max(v,0);return float3(v.r<=.0031308?v.r*12.92:1.055*pow(v.r,1/2.4)-.055,v.g<=.0031308?v.g*12.92:1.055*pow(v.g,1/2.4)-.055,v.b<=.0031308?v.b*12.92:1.055*pow(v.b,1/2.4)-.055);}
[numthreads(8,8,1)] void main(uint3 p:SV_DispatchThreadID){if(p.x>=width||p.y>=height)return;float4 original=source[p.xy];float3 rgb=linearize(original.rgb);rgb=pow(max(0,(rgb-.18)*(1+contrast/100)+.18)*exp2(brightness/50),exp2(-gamma/100));float l=dot(rgb,float3(.2126,.7152,.0722));float spread=max(rgb.r,max(rgb.g,rgb.b))-min(rgb.r,min(rgb.g,rgb.b));rgb=l+(rgb-l)*(1+saturation/100+vibrance/100*(1-saturate(spread)));float c=cos(radians(hue)),s=sin(radians(hue));rgb=mul(float3x3(.299+.701*c+.168*s,.587-.587*c+.330*s,.114-.114*c-.497*s,.299-.299*c-.328*s,.587+.413*c+.035*s,.114-.114*c+.292*s,.299-.299*c+1.250*s,.587-.587*c-1.050*s,.114+.886*c-.203*s),rgb);float2 uv=float2(p.xy)/float2(width,height);if(all(uv>=float2(rx,ry))&&all(uv<=float2(rx+rw,ry+rh))){float edge=min(min((uv.x-rx)/rw,(rx+rw-uv.x)/rw),min((uv.y-ry)/rh,(ry+rh-uv.y)/rh));float3 a=linearize(source[uint2(p.x>0?p.x-1:0,p.y)].rgb),b=linearize(source[uint2(min(width-1,p.x+1),p.y)].rgb);rgb+=saturate(edge*20)*intensity*(tone*.1+(structure-.8)*(linearize(original.rgb)-(a+b)/2));}output[p.xy]=float4(saturate(encode(rgb)),original.a);}

